# SalesFlow Enterprise — environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

APP_NAME="SalesFlow Enterprise"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.tld
APP_TIMEZONE=Europe/Brussels
APP_LOCALE=nl
# Generate a 32+ character random string (used for signing tokens).
APP_KEY=

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salesflow
DB_USER=root
DB_PASSWORD=

# Sessions
SESSION_LIFETIME=7200
REMEMBER_DAYS=30
SESSION_SECURE=true

# Mail (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.your-provider.tld
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@your-domain.tld
MAIL_FROM_NAME="SalesFlow Enterprise"

# Google (Gmail, Calendar, Maps, Places, Routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://your-domain.tld/oauth/google/callback
GOOGLE_MAPS_KEY=

# Microsoft (Graph, Teams, Outlook Calendar)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT=https://your-domain.tld/oauth/microsoft/callback

# Web Push (VAPID) — generate with the shipped key generator
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.tld
